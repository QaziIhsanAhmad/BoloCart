# ---- Cost guard (keep dry_run/test until costs are approved) ----
SEND_MODE=dry_run            # dry_run | test | live
LIVE_APPROVED=no             # must be "yes" for live sends
TEST_RECIPIENTS=             # comma-separated wa_ids, e.g. 923001234567
MAX_TEMPLATES_PER_DAY=30
NO_REPLY_HOURS=24
HEALTH_KEY=change-me-long-random

# ---- WhatsApp Cloud API (the client's own Meta account) ----
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_WABA_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=change-me-random
GRAPH_VERSION=v25.0
TEMPLATE_NAME=cod_order_confirm
TEMPLATE_LANG=ur

# ---- Shopify custom app (scopes: read_orders, write_orders) ----
SHOP_DOMAIN=
SHOP_TOKEN=
SHOP_API_SECRET=
SHOP_API_VERSION=2026-04
STORE_NAME=Demo Store

# ---- Public URL (free ngrok static domain) ----
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
PUBLIC_URL=https://${NGROK_DOMAIN}

# ---- Local LLM ----
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
